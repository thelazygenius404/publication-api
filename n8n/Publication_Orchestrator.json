      "parameters": {
        "jsCode": "const response = $json;\nconst job = $('4. Normalize Job').first().json;\n\nfunction extractApiError(data) {\n\n  if (\n    data &&\n    typeof data === 'object' &&\n    data.code &&\n    data.message\n  ) {\n    return data;\n  }\n\n  const raw =\n    data?.error?.message ??\n    data?.message ??\n    '';\n\n  const text = String(raw);\n\n  const firstBrace = text.indexOf('{');\n  const lastBrace = text.lastIndexOf('}');\n\n  if (\n    firstBrace !== -1 &&\n    lastBrace > firstBrace\n  ) {\n\n    let candidate =\n      text.substring(\n        firstBrace,\n        lastBrace + 1\n      );\n\n    try {\n      return JSON.parse(candidate);\n    } catch (_) {}\n\n    try {\n\n      candidate =\n        candidate\n          .replace(/\\\\\"/g, '\"')\n          .replace(/\\\\\\\\/g, '\\\\');\n\n      return JSON.parse(candidate);\n\n    } catch (_) {}\n  }\n\n  return null;\n}\n\nconst apiError =\n  extractApiError(response);\n\nconst baseContextOk =\n  !apiError &&\n  response?.publicationId != null &&\n  Number(response.publicationId) === Number(job.publicationId) &&\n  response?.destination === job.destination;\n\nconst wordpressContextOk =\n  job.destination === 'WORDPRESS' &&\n  Boolean(response?.siteUrl) &&\n  Boolean(response?.username) &&\n  Boolean(response?.credential);\n\nconst linkedInContextOk =\n  job.destination === 'LINKEDIN' &&\n  Boolean(response?.credential) &&\n  Boolean(response?.authorUrn) &&\n  Boolean(response?.apiVersion);\n\nconst contextOk =\n  baseContextOk &&\n  (\n    wordpressContextOk ||\n    linkedInContextOk\n  );\n\nconst errorCode =\n  apiError?.code ?? null;\n\nconst stopCleanlyCodes = [\n  'PUBLICATION_CANCELLED',\n  'PUBLICATION_ALREADY_PUBLISHED',\n  'PUBLICATION_FAILED',\n  'PUBLICATION_NOT_FOUND'\n];\n\nconst stopCleanly =\n  errorCode !== null &&\n  stopCleanlyCodes.includes(errorCode);\n\nreturn [\n  {\n    json: {\n      ...job,\n\n      contextOk,\n\n      context:\n        contextOk\n          ? response\n          : null,\n\n      errorCode,\n\n      stopCleanly,\n\n      contextError:\n        contextOk\n          ? null\n          : (\n              apiError?.message ??\n              response?.error?.message ??\n              response?.message ??\n              'Unable to obtain execution context'\n            )\n    }\n  }\n];"
      },
