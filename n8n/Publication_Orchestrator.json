      "parameters": {
        "jsCode": "const data =\n  $('10. Check Execution Context')\n    .first()\n    .json;\n\nconst context =\n  data.context;\n\nif (!context) {\n  throw new Error(\n    'WordPress context is missing'\n  );\n}\n\nconst raw =\n  `${context.username}:${context.credential}`;\n\nconst authorization =\n  `Basic ${Buffer\n    .from(raw, 'utf8')\n    .toString('base64')}`;\n\nreturn [\n  {\n    json: {\n      publicationId:\n        data.publicationId,\n\n      callbackUrl:\n        data.callbackUrl,\n\n      siteUrl:\n        context.siteUrl\n          .replace(/\\/+$/, ''),\n\n      title:\n        context.title,\n\n      body:\n        context.body,\n\n      authorization,\n\n      hasMedia:\n        Boolean(\n          context.mediaId &&\n          context.mediaDownloadUrl\n        ),\n\n      mediaId:\n        context.mediaId ?? null,\n\n      mediaDownloadUrl:\n        context.mediaDownloadUrl ?? null,\n\n      mediaContentType:\n        context.mediaContentType ?? null,\n\n      mediaOriginalFilename:\n        context.mediaOriginalFilename ??\n        'image',\n\n      mediaAltText:\n        context.mediaAltText ?? ''\n    }\n  }\n];"
