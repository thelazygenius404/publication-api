    {
      "parameters": {
        "jsCode": "const data =\n  $('10. Check Execution Context')\n    .first()\n    .json;\n\nconst context =\n  data.context;\n\nif (!context) {\n  throw new Error(\n    'LinkedIn context is missing'\n  );\n}\n\nif (!context.credential) {\n  throw new Error(\n    'LinkedIn access token is missing'\n  );\n}\n\nif (!context.authorUrn) {\n  throw new Error(\n    'LinkedIn author URN is missing'\n  );\n}\n\nif (!context.apiVersion) {\n  throw new Error(\n    'LinkedIn API version is missing'\n  );\n}\n\nconst commentary =\n  [\n    context.title,\n    context.body\n  ]\n    .filter(value =>\n      value &&\n      String(value).trim()\n    )\n    .map(value =>\n      String(value).trim()\n    )\n    .join('\\n\\n');\n\nif (!commentary) {\n  throw new Error(\n    'LinkedIn commentary is empty'\n  );\n}\n\nreturn [\n  {\n    json: {\n      publicationId:\n        data.publicationId,\n\n      callbackUrl:\n        data.callbackUrl,\n\n      authorization:\n        `Bearer ${context.credential}`,\n\n      apiVersion:\n        context.apiVersion,\n\n      body: {\n        author:\n          context.authorUrn,\n\n        commentary,\n\n        visibility:\n          'PUBLIC',\n\n        distribution: {\n          feedDistribution:\n            'MAIN_FEED',\n\n          targetEntities: [],\n\n          thirdPartyDistributionChannels: []\n        },\n\n        lifecycleState:\n          'PUBLISHED',\n\n        isReshareDisabledByAuthor:\n          false\n      }\n    }\n  }\n];"
      },
