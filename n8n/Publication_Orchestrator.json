      "parameters": {
        "jsCode": "const response = $json;\nconst job = $('4. Normalize Job').first().json;\n\nconst errorText =\n  response?.error?.message ??\n  response?.error ??\n  null;\n\nconst success = !errorText && response?.id != null;\n\nreturn [{\n  json: {\n    callbackUrl: job.callbackUrl,\n    publicationId: job.publicationId,\n    status: success ? 'PUBLISHED' : 'FAILED',\n    externalId: success ? String(response.id) : null,\n    n8nExecutionId: $execution.id,\n    errorMessage: success\n      ? null\n      : String(errorText || response?.message || 'WordPress publication failed')\n  }\n}];"
