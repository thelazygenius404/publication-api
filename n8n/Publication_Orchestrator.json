    {
      "parameters": {
        "jsCode": "const prepared =\n  $('13L. Prepare LinkedIn Request')\n    .first()\n    .json;\n\nconst initialized =\n  $('14LA. Initialize LinkedIn Image')\n    .first()\n    .json;\n\nconst imageUrn =\n  initialized?.value?.image;\n\nif (!imageUrn) {\n  throw new Error(\n    'LinkedIn image initialization did not return an image URN'\n  );\n}\n\nconst media = {\n  id: imageUrn\n};\n\nif (\n  prepared.mediaAltText &&\n  prepared.mediaAltText.trim()\n) {\n  media.altText =\n    prepared.mediaAltText.trim();\n}\n\nreturn [\n  {\n    json: {\n      publicationId:\n        prepared.publicationId,\n\n      callbackUrl:\n        prepared.callbackUrl,\n\n      authorization:\n        prepared.authorization,\n\n      apiVersion:\n        prepared.apiVersion,\n\n      body: {\n        author:\n          prepared.authorUrn,\n\n        commentary:\n          prepared.commentary,\n\n        visibility:\n          'PUBLIC',\n\n        distribution: {\n          feedDistribution:\n            'MAIN_FEED',\n\n          targetEntities: [],\n\n          thirdPartyDistributionChannels: []\n        },\n\n        content: {\n          media\n        },\n\n        lifecycleState:\n          'PUBLISHED',\n\n        isReshareDisabledByAuthor:\n          false\n      }\n    }\n  }\n];"
      },
