    {
      "parameters": {
        "jsCode": "const data =\n  $('10. Check Execution Context')\n    .first()\n    .json;\n\nconst response = $json;\n\nconst statusCode =\n  Number(\n    response?.statusCode ??\n    response?.status ??\n    response?.statusCodeValue ??\n    0\n  );\n\nconst headers =\n  response?.headers ?? {};\n\nconst body =\n  response?.body ?? response;\n\nconst success =\n  statusCode === 201;\n\nconst externalId =\n  headers['x-restli-id'] ??\n  headers['X-RestLi-Id'] ??\n  null;\n\nlet errorMessage = null;\n\nif (!success) {\n\n  const linkedInMessage =\n    body?.message ??\n    body?.error_description ??\n    body?.error ??\n    response?.error?.message ??\n    null;\n\n  errorMessage =\n    linkedInMessage\n      ? `LinkedIn publish failed (HTTP ${statusCode || 'unknown'}): ${linkedInMessage}`\n      : `LinkedIn publish failed with HTTP ${statusCode || 'unknown'}`;\n}\n\nreturn [\n  {\n    json: {\n      callbackUrl:\n        data.callbackUrl,\n\n      publicationId:\n        data.publicationId,\n\n      status:\n        success\n          ? 'PUBLISHED'\n          : 'FAILED',\n\n      externalId:\n        success\n          ? externalId\n          : null,\n\n      n8nExecutionId:\n        $execution.id,\n\n      errorMessage\n    }\n  }\n];"
