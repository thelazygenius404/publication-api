      "parameters": {
        "jsCode": "const input = $json.body ?? {};\n\nconst publicationId = Number(input.publicationId);\nif (!Number.isInteger(publicationId) || publicationId <= 0) {\n  throw new Error('publicationId must be a positive integer');\n}\n\nconst destination = String(input.destination ?? '').toUpperCase();\nif (!['WORDPRESS', 'LINKEDIN'].includes(destination)) {\n  throw new Error('destination must be WORDPRESS or LINKEDIN');\n}\n\nif (!input.callbackUrl || !input.contextUrl) {\n  throw new Error('callbackUrl and contextUrl are required');\n}\n\nconst scheduledAt = input.scheduledAt || null;\nif (scheduledAt && Number.isNaN(Date.parse(scheduledAt))) {\n  throw new Error('scheduledAt must be a valid ISO-8601 date/time');\n}\n\nreturn [{\n  json: {\n    publicationId,\n    destination,\n    scheduledAt,\n    callbackUrl: String(input.callbackUrl),\n    contextUrl: String(input.contextUrl)\n  }\n}];"
      },
