      "parameters": {
        "jsCode": "const data = $('10. Check Execution Context').first().json;\nconst context = data.context;\n\nif (!context) {\n  throw new Error('WordPress context is missing');\n}\n\nconst raw = `${context.username}:${context.credential}`;\nconst authorization = `Basic ${Buffer.from(raw, 'utf8').toString('base64')}`;\n\nreturn [{\n  json: {\n    publicationId: data.publicationId,\n    callbackUrl: data.callbackUrl,\n    siteUrl: context.siteUrl.replace(/\\/+$/, ''),\n    title: context.title,\n    body: context.body,\n    authorization\n  }\n}];"
      },
