    {
      "parameters": {
        "jsCode": "const data =\n  $('10. Check Execution Context')\n    .first()\n    .json;\n\nconst context =\n  data.context;\n\nif (!context) {\n  throw new Error(\n    'LinkedIn context is missing'\n  );\n}\n\nif (!context.credential) {\n  throw new Error(\n    'LinkedIn access token is missing'\n  );\n}\n\nif (!context.authorUrn) {\n  throw new Error(\n    'LinkedIn author URN is missing'\n  );\n}\n\nif (!context.apiVersion) {\n  throw new Error(\n    'LinkedIn API version is missing'\n  );\n}\n\nconst commentary =\n  [\n    context.title,\n    context.body\n  ]\n    .filter(value =>\n      value &&\n      String(value).trim()\n    )\n    .map(value =>\n      String(value).trim()\n    )\n    .join('\\n\\n');\n\nif (!commentary) {\n  throw new Error(\n    'LinkedIn commentary is empty'\n  );\n}\n\nconst hasMedia =\n  Boolean(\n    context.mediaId &&\n    context.mediaDownloadUrl\n  );\n\nif (\n  hasMedia &&\n  ![\n    'image/jpeg',\n    'image/png'\n  ].includes(\n    context.mediaContentType\n  )\n) {\n  throw new Error(\n    'LinkedIn media must be JPEG or PNG'\n  );\n}\n\nreturn [\n  {\n    json: {\n      publicationId:\n        data.publicationId,\n\n      callbackUrl:\n        data.callbackUrl,\n\n      authorization:\n        `Bearer ${context.credential}`,\n\n      accessToken:\n        context.credential,\n\n      apiVersion:\n        context.apiVersion,\n\n      authorUrn:\n        context.authorUrn,\n\n      commentary,\n\n      hasMedia,\n\n      mediaId:\n        context.mediaId ?? null,\n\n      mediaDownloadUrl:\n        context.mediaDownloadUrl ?? null,\n\n      mediaContentType:\n        context.mediaContentType ?? null,\n\n      mediaOriginalFilename:\n        context.mediaOriginalFilename ?? 'image',\n\n      mediaAltText:\n        context.mediaAltText ?? ''\n    }\n  }\n];"
      },
