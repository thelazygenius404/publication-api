      "parameters": {
        "jsCode": "const prepared =\n  $('13. Prepare WordPress Request')\n    .first()\n    .json;\n\nconst upload =\n  $json;\n\nif (!upload?.id) {\n  throw new Error(\n    'WordPress media upload did not return a media ID'\n  );\n}\n\nreturn [\n  {\n    json: {\n      publicationId:\n        prepared.publicationId,\n\n      callbackUrl:\n        prepared.callbackUrl,\n\n      siteUrl:\n        prepared.siteUrl,\n\n      authorization:\n        prepared.authorization,\n\n      title:\n        prepared.title,\n\n      body:\n        prepared.body,\n\n      featuredMedia:\n        Number(upload.id)\n    }\n  }\n];"
